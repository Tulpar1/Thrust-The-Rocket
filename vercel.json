{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "favicon.ico",
      "use": "@vercel/static"
    },
    {
      "src": "Logo.ico",
      "use": "@vercel/static"
    },
    {
      "src": "Logo.png",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/static/$1"
    },
    {
      "src": "/favicon\\.ico",
      "dest": "/static/favicon.ico"
    },
    {
      "src": "/Logo\\.ico",
      "dest": "/static/Logo.ico"
    },
    {
      "src": "/Logo\\.png",
      "dest": "/static/img/logo.png"
    },
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ]
}
